FROM python:3.12.11-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Dependências do sistema
RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Clona a versão correta do PADE
RUN git clone --branch pade2026 https://github.com/grei-ufc/pade.git

WORKDIR /app/pade

RUN pip install --no-cache-dir mosaik-api-v3==3.0.14

# Atualiza pip + ferramentas base
RUN pip install --no-cache-dir --upgrade \
    pip==24.2 \
    setuptools==75.1.0 \
    wheel==0.44.0

# Instala dependências críticas com versões FIXAS
RUN pip install --no-cache-dir \
    twisted==24.7.0 \
    autobahn==23.6.2 \
    zope.interface==6.4.post2 \
    attrs==24.2.0 \
    automat==24.8.1 \
    constantly==23.10.4 \
    incremental==24.7.2 \
    hyperlink==21.0.0 \
    pyzmq==26.0.3

# Caso o PADE tenha requirements próprios
RUN if [ -f requirements.txt ]; then pip install --no-cache-dir -r requirements.txt; fi

# Instala o PADE
RUN pip install --no-cache-dir .

# Ferramentas úteis para debug
RUN pip install --no-cache-dir ipython==8.26.0

# Diretório para seus agentes
WORKDIR /app

EXPOSE 8000

CMD ["bash"]